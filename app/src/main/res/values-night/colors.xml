<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-theme overrides. Only tokens that actually need a different value in
  dark mode are listed here — anything not overridden (e.g. primary_dark,
  used for the status/action bar) falls back to values/colors.xml, which is
  intentional: the brand-green bar stays the same dark green in both themes.

  Every screen and all three custom Canvas charts already read colors only
  through these @color/* tokens (never a hardcoded hex), so this file alone
  is what makes the whole app follow the system's light/dark setting — no
  other file needed a code change for this.
-->
<resources>
    <color name="background">#121513</color>
    <color name="surface">#1C201D</color>
    <color name="text_primary">#ECF0EC</color>
    <color name="text_secondary">#9DAA9F</color>
    <color name="divider">#2C332D</color>
    <color name="card_stroke">#333B34</color>
    <color name="surface_alt">#22271F</color>
    <color name="primary">#66BB6A</color>
    <color name="primary_soft">#1E2B1F</color>
    <color name="danger">#EF5350</color>
    <color name="progress_track">#2A312B</color>

    <!-- Macro-nutrient accents: same hues, lifted for legibility on a dark
         surface; the "track" (unfilled bar) becomes a dark tint of the same
         hue instead of a near-white pastel. -->
    <color name="macro_protein">#F08072</color>
    <color name="macro_protein_track">#3A2621</color>
    <color name="macro_carbs">#F0C042</color>
    <color name="macro_carbs_track">#3A3220</color>
    <color name="macro_fat">#7B9EF0</color>
    <color name="macro_fat_track">#232C42</color>

    <!-- Chart colors (custom canvas views) -->
    <color name="chart_line">#66BB6A</color>
    <color name="chart_fill">#3366BB6A</color>
    <color name="chart_grid">#2C332D</color>
    <color name="chart_bar_past">#3D5B40</color>
    <color name="chart_bar_today">#66BB6A</color>
    <color name="chart_bar_over">#D9695F</color>
    <color name="chart_bar_over_today">#EF5350</color>

    <!-- Physical-activity screen accent -->
    <color name="activity_accent">#66BB6A</color>
    <color name="activity_accent_soft">#1E2B1F</color>
    <!-- Food search -->
    <color name="star_on">#FFC933</color>
    <color name="primary_dark_on_soft">#A5D6A7</color>
</resources>
